@model ABC_Retail_WebApp.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-4">
    <h1 class="h3 mb-0">ABC Retail Dashboard</h1>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon stat-icon-blue"><i class="bi bi-people"></i></div>
                <div>
                    <div class="text-muted small">Customers</div>
                    <div class="fs-2 fw-semibold">@Model.CustomerCount</div>
                </div>
            </div>
            <a asp-controller="Customers" asp-action="Index" class="card-footer text-decoration-none small">View customers &rarr;</a>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon stat-icon-violet"><i class="bi bi-box-seam"></i></div>
                    <div>
                        <div class="text-muted small">Products</div>
                        <div class="fs-2 fw-semibold">@Model.ProductCount</div>
                    </div>
                </div>
                @if (Model.OutOfStockCount > 0 || Model.LowStockCount > 0)
                {
                    <div class="small mt-2 d-flex gap-1">
                        @if (Model.OutOfStockCount > 0)
                        {
                            <span class="badge bg-danger">@Model.OutOfStockCount out of stock</span>
                        }
                        @if (Model.LowStockCount > 0)
                        {
                            <span class="badge bg-warning text-dark">@Model.LowStockCount low stock</span>
                        }
                    </div>
                }
            </div>
            <a asp-controller="Products" asp-action="Index" class="card-footer text-decoration-none small">View products &rarr;</a>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon stat-icon-amber"><i class="bi bi-receipt"></i></div>
                <div>
                    <div class="text-muted small">Orders</div>
                    <div class="fs-2 fw-semibold">@Model.TotalOrders</div>
                </div>
            </div>
            <a asp-controller="Orders" asp-action="Index" class="card-footer text-decoration-none small">View orders &rarr;</a>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon stat-icon-rose"><i class="bi bi-clock-history"></i></div>
                <div>
                    <div class="text-muted small">Pending Orders</div>
                    <div class="fs-2 fw-semibold">@Model.OrdersByStatus.GetValueOrDefault("Pending", 0)</div>
                </div>
            </div>
            <a asp-controller="Orders" asp-action="Index" class="card-footer text-decoration-none small">Review &rarr;</a>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-semibold">Orders by Status</div>
            @if (Model.TotalOrders == 0)
            {
                <div class="card-body">
                    <p class="text-muted mb-0">No orders yet.</p>
                </div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var (status, count) in Model.OrdersByStatus)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span class="badge @ABC_Retail_WebApp.Models.OrderStatuses.BadgeCssClass(status)">@status</span>
                            <span class="fw-semibold">@count</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-semibold">Quick Links</div>
            <div class="list-group list-group-flush">
                <a class="list-group-item list-group-item-action" asp-controller="Customers" asp-action="Create"><i class="bi bi-person-plus"></i> New customer</a>
                <a class="list-group-item list-group-item-action" asp-controller="Products" asp-action="Create"><i class="bi bi-box-seam"></i> New product</a>
                <a class="list-group-item list-group-item-action" asp-controller="Orders" asp-action="Create"><i class="bi bi-receipt"></i> Place order</a>
                <a class="list-group-item list-group-item-action" asp-controller="QueueMonitor" asp-action="Index"><i class="bi bi-arrow-left-right"></i> View Queue Monitor</a>
                <a class="list-group-item list-group-item-action" asp-controller="Logs" asp-action="Index"><i class="bi bi-journal-text"></i> View Activity Logs</a>
            </div>
        </div>
    </div>
</div>
