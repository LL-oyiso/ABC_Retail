@model IEnumerable<ABC_Retail_WebApp.Models.Product>
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">Products</h1>
    <a class="btn btn-primary" asp-action="Create">Create product</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No products yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th></th>
                    <th>Product Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td style="width: 64px;">
                            @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                            {
                                <img src="@p.ImageUrl" alt="@p.ProductName" class="rounded" style="width: 48px; height: 48px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="bg-light rounded d-flex align-items-center justify-content-center text-muted" style="width: 48px; height: 48px; font-size: 0.7rem;">N/A</div>
                            }
                        </td>
                        <td class="fw-semibold">@p.ProductName</td>
                        <td><span class="badge text-bg-secondary">@p.Category</span></td>
                        <td>@p.Price.ToString("C")</td>
                        <td>
                            @if (p.StockQuantity <= 0)
                            {
                                <span class="badge text-bg-danger">Out of stock</span>
                            }
                            else
                            {
                                @p.StockQuantity
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex gap-1 justify-content-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-category="@p.Category" asp-route-id="@p.RowKey">Details</a>
                                <a class="btn btn-sm btn-outline-dark" asp-action="AdjustStock" asp-route-category="@p.Category" asp-route-id="@p.RowKey">Adjust Stock</a>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-category="@p.Category" asp-route-id="@p.RowKey">Edit</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-category="@p.Category" asp-route-id="@p.RowKey">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
