@model ABC_Retail_WebApp.Models.Product
@{
    ViewData["Title"] = "Delete Product";
}

<h1 class="h3 mb-3">Delete product</h1>

<div class="card">
    <div class="card-body">
        <div class="alert alert-danger">This action cannot be undone. The product image will also be removed from Blob Storage.</div>

        <div class="row">
            <div class="col-md-3 mb-3">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.ProductName" class="img-fluid rounded" />
                }
            </div>
            <div class="col-md-9">
                <dl class="row">
                    <dt class="col-sm-3">Product Name</dt>
                    <dd class="col-sm-9">@Model.ProductName</dd>

                    <dt class="col-sm-3">Category</dt>
                    <dd class="col-sm-9">@Model.Category</dd>

                    <dt class="col-sm-3">Price</dt>
                    <dd class="col-sm-9">@Model.FormattedPrice</dd>

                    <dt class="col-sm-3">Stock Quantity</dt>
                    <dd class="col-sm-9">@Model.StockQuantity</dd>
                </dl>
            </div>
        </div>

        <form asp-action="Delete" asp-route-category="@Model.Category" asp-route-id="@Model.RowKey" method="post" class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>
