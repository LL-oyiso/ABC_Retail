@model ABC_Retail_WebApp.Models.Product
@{
    ViewData["Title"] = "Product Details";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">@Model.ProductName</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-dark" asp-action="AdjustStock" asp-route-category="@Model.Category" asp-route-id="@Model.RowKey">Adjust Stock</a>
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-category="@Model.Category" asp-route-id="@Model.RowKey">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col-md-3 mb-3">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.ProductName" class="img-fluid rounded" />
                }
                else
                {
                    <div class="bg-light rounded d-flex align-items-center justify-content-center text-muted" style="height: 150px;">No image</div>
                }
            </div>
            <div class="col-md-9">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Category</dt>
                    <dd class="col-sm-9"><span class="badge bg-secondary">@Model.Category</span></dd>

                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>

                    <dt class="col-sm-3">Price</dt>
                    <dd class="col-sm-9">@Model.Price.ToString("C")</dd>

                    <dt class="col-sm-3">Stock Quantity</dt>
                    <dd class="col-sm-9">@Model.StockQuantity</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
