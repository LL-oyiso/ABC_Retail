@model ABC_Retail_WebApp.ViewModels.OrderSummary
@{
    ViewData["Title"] = "Order Details";
    var order = Model.Order;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">Order @order.OrderId</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@order.RowKey">Update Status</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Customer</dt>
            <dd class="col-sm-9">@Model.CustomerName</dd>

            <dt class="col-sm-3">Product</dt>
            <dd class="col-sm-9">@Model.ProductName</dd>

            <dt class="col-sm-3">Quantity</dt>
            <dd class="col-sm-9">@order.Quantity</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9"><span class="badge @ABC_Retail_WebApp.Models.OrderStatuses.BadgeCssClass(order.Status)">@order.Status</span></dd>

            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9">@order.CreatedAt.ToLocalTime().ToString("D") at @order.CreatedAt.ToLocalTime().ToString("t")</dd>
        </dl>
    </div>
</div>
