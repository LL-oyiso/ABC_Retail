@model IEnumerable<ABC_Retail_WebApp.ViewModels.OrderSummary>
@{
    ViewData["Title"] = "Orders";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">Orders</h1>
    <a class="btn btn-primary" asp-action="Create">Place order</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No orders yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Product</th>
                    <th>Qty</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="fw-semibold">@s.CustomerName</td>
                        <td>@s.ProductName</td>
                        <td>@s.Order.Quantity</td>
                        <td>
                            <span class="badge @ABC_Retail_WebApp.Models.OrderStatuses.BadgeCssClass(s.Order.Status)">@s.Order.Status</span>
                        </td>
                        <td>@s.Order.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td class="text-end">
                            <div class="d-flex gap-1 justify-content-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@s.Order.RowKey">Details</a>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@s.Order.RowKey">Update Status</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@s.Order.RowKey">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
